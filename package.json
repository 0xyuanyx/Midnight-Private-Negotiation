{
  "name": "midnight-private-negotiation-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "node scripts/check-toolchain.mjs && npm ci && npm run contract:compile && npm run build",
    "build": "npm run sync-assets --workspace @midnight-negotiation/negotiation-contract && tsc -b",
    "clean": "tsc -b --clean",
    "contract:compile": "node scripts/check-toolchain.mjs && npm run compact --workspace @midnight-negotiation/negotiation-contract",
    "demo:controller:base": "npm run build && node packages/demo-controller/dist/server.js",
    "demo:controller": "NEGOTIATION_AI_PROVIDER=openai npm run demo:controller:base",
    "demo:mock": "NEGOTIATION_AI_PROVIDER=mock npm run demo:controller:base",
    "demo:ai": "npm run demo:controller",
    "demo:midnight": "NEGOTIATION_AI_PROVIDER=openai MIDNIGHT_MODE=local npm run demo:controller:base",
    "demo:midnight:mock": "NEGOTIATION_AI_PROVIDER=mock MIDNIGHT_MODE=local npm run demo:controller:base",
    "demo:midnight:ai": "npm run demo:midnight",
    "midnight:up": "docker compose -f infra/midnight-local.yml up -d --wait",
    "midnight:down": "docker compose -f infra/midnight-local.yml down",
    "typecheck": "npm run sync-assets --workspace @midnight-negotiation/negotiation-contract && tsc -b --pretty false",
    "test": "npm run build && node --test packages/agent-core/test/*.test.mjs packages/protocol/test/*.test.mjs packages/negotiation-contract/test/*.test.mjs packages/room-relay/test/*.test.mjs packages/demo-controller/test/*.test.mjs",
    "test:openai": "npm run build && node scripts/test-openai-negotiation.mjs",
    "demo:local": "node scripts/demo-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "smoldot": "npm:@aspect-build/empty@0.0.0"
  }
}
